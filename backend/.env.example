# OriginX Configuration
PROJECT_NAME="OriginX"
VERSION="1.0.0"
DATABASE_URL="sqlite+aiosqlite:///./originx.db"

# To use PostgreSQL in production, set:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/originx"

# External Registry URLs
NPM_REGISTRY_URL="https://registry.npmjs.org"
PYPI_REGISTRY_URL="https://pypi.org/pypi"
OSV_API_URL="https://api.osv.dev/v1/query"

# Limits & Protection
MAX_ARCHIVE_SIZE_BYTES=26214400
MAX_EXTRACTED_SIZE_BYTES=62914560
MAX_ARCHIVE_FILES=5000
HTTP_TIMEOUT_SECONDS=12.0
DEMO_MODE_ENABLED=true
